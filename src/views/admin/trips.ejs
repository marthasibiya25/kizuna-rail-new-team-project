<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <main class="container">
    <h1>Trip Administration</h1>
    <p>Logged in as: <strong><%= user ? user.username : 'Admin' %></strong></p>

    <section class="admin-table-container">
      <table id="trips-table">
        <thead>
          <tr>
            <th>Route Name</th>
            <th>Region</th>
            <th>Start Station</th>
            <th>End Station</th>
            <th>Duration</th>
            <th>Distance</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="trips-table-body">
          <% if (typeof trips !== 'undefined' && trips.length > 0) { %>
            <% trips.forEach(trip => { %>
              <tr data-id="<%= trip._id %>">
                <td><strong><%= trip.name %></strong></td>
                <td class="text-capitalize"><%= trip.region %></td>
                <td class="text-capitalize"><%= trip.startStation %></td>
                <td class="text-capitalize"><%= trip.endStation %></td>
                <td><%= trip.duration %></td>
                <td><%= trip.distance %> km</td>
                <td>
                  <div class="action-buttons">
                    <button type="button" class="btn btn-edit" data-id="<%= trip._id %>">Edit</button>
                    <button type="button" class="btn btn-delete" data-id="<%= trip._id %>">Delete</button>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7">Loading trips...</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </section>

    <dialog id="edit-trip-modal">
      <form id="edit-trip-form">
        <h2>Edit Route</h2>
        <input type="hidden" id="edit-trip-id" />
        
        <label for="edit-name">Route Name:</label>
        <input type="text" id="edit-name" required />

        <label for="edit-region">Region:</label>
        <input type="text" id="edit-region" required />

        <label for="edit-start">Start Station:</label>
        <input type="text" id="edit-start" required />

        <label for="edit-end">End Station:</label>
        <input type="text" id="edit-end" required />

        <label for="edit-duration">Duration:</label>
        <input type="text" id="edit-duration" required />

        <label for="edit-distance">Distance (km):</label>
        <input type="number" id="edit-distance" required />

        <menu>
          <button type="button" id="cancel-edit-btn">Cancel</button>
          <button type="submit">Save Changes</button>
        </menu>
      </form>
    </dialog>
  </main>

  <script src="/js/admin-trips.js" type="module"></script>
</body>
</html>