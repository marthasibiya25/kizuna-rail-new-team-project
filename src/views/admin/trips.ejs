<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <main class="container">
    <h1>Trip Administration</h1>
    <p>Logged in as: <strong><%= user ? user.username : 'Admin' %></strong></p>

    <section class="admin-table-container">
      <table id="trips-table">
        <thead>
          <tr>
            <th>Start Station</th>
            <th>End Station</th>
            <th>Departure Time</th>
            <th>Arrival Time</th>
            <th>Train ID</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="trips-table-body">
          <tr>
            <td colspan="6">Loading trips...</td>
          </tr>
        </tbody>
      </table>
    </section>

    <dialog id="edit-trip-modal">
      <form id="edit-trip-form">
        <h2>Edit Trip</h2>
        <input type="hidden" id="edit-trip-id" />
        
        <label for="edit-start">Start Station:</label>
        <input type="text" id="edit-start" required />

        <label for="edit-end">End Station:</label>
        <input type="text" id="edit-end" required />

        <label for="edit-departure">Departure Time:</label>
        <input type="text" id="edit-departure" required />

        <label for="edit-arrival">Arrival Time:</label>
        <input type="text" id="edit-arrival" required />

        <label for="edit-train">Train ID:</label>
        <input type="text" id="edit-train" required />

        <menu>
          <button type="button" id="cancel-edit-btn">Cancel</button>
          <button type="submit">Save Changes</button>
        </menu>
      </form>
    </dialog>
  </main>

  <script src="/js/admin-trips.js" type="module"></script>
</body>
</html>